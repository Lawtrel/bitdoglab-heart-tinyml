% Article-type value table for MSBJournal.cls, loaded via \articletype{art}.
% \renewcommand* (not \newcommand*): this file can be \input more than once
% per compile (e.g. an Anais alternating full papers and extended abstracts),
% so it must be safe to re-apply, not just define-once.

% Set article type name for header
\renewcommand*{\articletypename}{\textbf{FULL PAPER}}

% Set definitions
\definecolor{ppgmsbC1}{cmyk}{96,0,100,0}
\definecolor{ppgmsbC2}{RGB}{36,96,84}
\definecolor{ppgmsbC3}{RGB}{0,48,58}

\renewcommand*{\typeColorLogo}{ppgmsbC1}
\renewcommand*{\typeColorTitle}{ppgmsbC3}

\endinput
